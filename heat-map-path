<!DOCTYPE html>
<html>
<body style="font-family: sans-serif; padding: 20px;">
    <h2>Engagement Data Extractor</h2>
    <p>1. Paste your 'd' string:</p>
    <textarea id="dInput" placeholder="Paste here..." style="width:100%; height:80px;"></textarea>
    
    <p>2. Video Length (in seconds):</p>
    <input type="number" id="vLen" value="14444" style="padding: 5px;">
    
    <br><br>
    <button onclick="process()" style="padding: 10px 20px; font-weight: bold; cursor: pointer;">Download Sorted CSV</button>

    <script>
    function process() {
        let d = document.getElementById('dInput').value;
        let vLen = parseInt(document.getElementById('vLen').value);
        let nums = d.replace(/[A-Za-z]/g, ' ').split(/\s+/).filter(x => x).map(Number);
        
        let data = [];
        for (let i = 0; i < nums.length; i += 2) {
            let time = (nums[i] / 1000) * vLen;
            let intensity = 100 - nums[i+1]; // Flips it so high = high
            data.push({time: time.toFixed(2), intensity: intensity.toFixed(2)});
        }
        
        // Sort by Intensity: Highest first
        data.sort((a, b) => b.intensity - a.intensity);
        
        let csv = "Timestamp (sec),Intensity\n";
        data.forEach(row => csv += row.time + "," + row.intensity + "\n");
        
        let blob = new Blob([csv], {type: 'text/csv'});
        let link = document.createElement('a');
        link.href = window.URL.createObjectURL(blob);
        link.download = "sorted_heatmap.csv";
        link.click();
    }
    </script>
</body>
</html>
